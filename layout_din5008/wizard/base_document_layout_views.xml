<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_base_document_layout" model="ir.ui.view">
        <field name="name">base.document.layout.form.inherit.layout_din5008</field>
        <field name="model">base.document.layout</field>
        <field name="inherit_id" ref="web.view_base_document_layout" />
        <field name="arch" type="xml">
            <field name="paperformat_id" position="after">
                <field name="layout_din5008_is_din" invisible="1" />
            </field>
            <!--
                The DIN settings are grouped in tabs. A notebook (unlike a
                nested group) keeps the company group an inner group, so the
                labels of the standard fields are preserved.
            -->
            <xpath
                expr="//group[hasclass('o_document_layout_company')]"
                position="inside"
            >
                <notebook
                    name="layout_din5008"
                    colspan="2"
                    invisible="not layout_din5008_is_din"
                >
                    <page name="layout_din5008_document" string="DIN 5008 Document">
                        <group>
                            <field
                                name="layout_din5008_informations_position"
                                string="Document Information"
                                widget="radio"
                            />
                            <field
                                name="layout_din5008_logo_position"
                                string="Logo Position"
                                widget="radio"
                                options="{'horizontal': true}"
                            />
                            <field
                                name="layout_din5008_fold_marks"
                                string="Fold Marks"
                            />
                            <field name="layout_din5008_hole_mark" string="Hole Mark" />
                        </group>
                    </page>
                    <page name="layout_din5008_sender" string="Sender Line">
                        <group>
                            <field
                                name="layout_din5008_sender_line"
                                string="Print Sender Line"
                            />
                            <field
                                name="layout_din5008_sender_separator"
                                string="Separator"
                                invisible="not layout_din5008_sender_line"
                            />
                            <field
                                name="layout_din5008_sender_country"
                                string="Country"
                                invisible="not layout_din5008_sender_line"
                            />
                        </group>
                    </page>
                    <page name="layout_din5008_geometry" string="Positions (mm)">
                        <group>
                            <field
                                name="layout_din5008_address_offset_top"
                                string="Address Window Offset"
                                class="o_report_preview_highlight_address"
                            />
                            <field
                                name="layout_din5008_address_height"
                                string="Address Window Height"
                                class="o_report_preview_highlight_address"
                            />
                            <field
                                name="layout_din5008_remark_zone_height"
                                string="Remark Zone Height"
                                class="o_report_preview_highlight_address"
                            />
                            <field
                                name="layout_din5008_info_left"
                                string="Information Block Left"
                                class="o_report_preview_highlight_information_block"
                            />
                            <field
                                name="layout_din5008_info_width"
                                string="Information Block Width"
                                class="o_report_preview_highlight_information_block"
                            />
                        </group>
                    </page>
                </notebook>
            </xpath>
            <!--
                The bottom margin of l10n_de_report_footer is a position too;
                a move is only processed as a direct child of the spec node.
            -->
            <xpath
                expr="//page[@name='layout_din5008_geometry']/group"
                position="inside"
            >
                <field name="report_footer_margin_bottom" position="move" />
            </xpath>
            <field name="report_footer_margin_bottom" position="attributes">
                <attribute name="string">Bottom Margin</attribute>
            </field>
        </field>
    </record>
</odoo>
