<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_base_document_layout" model="ir.ui.view">
        <field name="name">base.document.layout.form.inherit.layout_din5008</field>
        <field name="model">base.document.layout</field>
        <field name="inherit_id" ref="web.view_base_document_layout" />
        <field name="arch" type="xml">
            <field name="paperformat_id" position="after">
                <field name="layout_din5008_is_din" invisible="1" />
                <field
                    name="layout_din5008_informations_position"
                    string="Document Information"
                    widget="radio"
                    invisible="not layout_din5008_is_din"
                />
                <field
                    name="layout_din5008_logo_position"
                    string="Logo Position"
                    widget="radio"
                    options="{'horizontal': true}"
                    invisible="not layout_din5008_is_din"
                />
                <field
                    name="layout_din5008_sender_line"
                    string="Sender Line"
                    invisible="not layout_din5008_is_din"
                />
                <field
                    name="layout_din5008_fold_marks"
                    string="Fold Marks"
                    invisible="not layout_din5008_is_din"
                />
                <label
                    for="layout_din5008_address_offset_top"
                    string="Address Window (mm)"
                    invisible="not layout_din5008_is_din"
                />
                <div
                    class="d-flex align-items-center gap-2"
                    invisible="not layout_din5008_is_din"
                >
                    <span class="text-muted">Offset</span>
                    <field name="layout_din5008_address_offset_top" class="w-auto" />
                    <span class="text-muted">Height</span>
                    <field name="layout_din5008_address_height" class="w-auto" />
                    <span class="text-muted">Remark zone</span>
                    <field name="layout_din5008_remark_zone_height" class="w-auto" />
                </div>
                <label
                    for="layout_din5008_info_left"
                    string="Information Block (mm)"
                    invisible="not layout_din5008_is_din"
                />
                <div
                    class="d-flex align-items-center gap-2"
                    invisible="not layout_din5008_is_din"
                >
                    <span class="text-muted">Left</span>
                    <field name="layout_din5008_info_left" class="w-auto" />
                    <span class="text-muted">Width</span>
                    <field name="layout_din5008_info_width" class="w-auto" />
                </div>
                <field
                    name="layout_din5008_margin_bottom"
                    string="Bottom Margin (mm)"
                    invisible="not layout_din5008_is_din"
                />
            </field>
        </field>
    </record>
</odoo>
